{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "Debug firmware (probe-rs)",
      "cwd": "${workspaceFolder}/firmware",
      "preLaunchTask": "firmware: build",
      "chip": "STM32F411RETx",
      "connectUnderReset": true,
      "flashingConfig": { "flashingEnabled": true, "haltAfterReset": false },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/firmware/target/thumbv7em-none-eabihf/debug/firmware",
          "rttEnabled": true
          // Register view: download STM32F411.svd (ST / cmsis-svd) into firmware/ and add
          // "svdFile": "${workspaceFolder}/firmware/STM32F411.svd"
        }
      ],
      "env": { "DEFMT_LOG": "debug" }
    },
    {
      "type": "probe-rs-debug",
      "request": "attach",
      "name": "Attach (probe-rs)",
      "cwd": "${workspaceFolder}/firmware",
      "chip": "STM32F411RETx",
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/firmware/target/thumbv7em-none-eabihf/debug/firmware",
          "rttEnabled": true
        }
      ]
    }
  ]
}
